# Browser-visible deployment URLs. Set these before a production build.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_MARKETLIFT_API_URL=http://localhost:8000
NEXT_PUBLIC_MARKETPLACE_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000

# Pagar.me browser tokenization key. Use pk_test_* in development/sandbox and
# the production public key only after Marketlift's Pagar.me marketplace account
# has completed commercial onboarding. Never expose PAGARME_SECRET_KEY here.
NEXT_PUBLIC_PAGARME_PUBLIC_KEY=

# Optional: required only when listing images are served from a different
# public origin than NEXT_PUBLIC_MARKETLIFT_API_URL (for example R2/S3 CDN).
NEXT_PUBLIC_MARKETLIFT_MEDIA_ORIGIN=
